# FraudShield AI — environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Authentication ────────────────────────────────────────────────────────────
# Required before launching the dashboard.
# Use a strong, randomly generated password in any shared or network environment.
FRAUDSHIELD_AUTH_USERNAME=admin
FRAUDSHIELD_AUTH_PASSWORD=change-me-before-use

# ── Audit storage ─────────────────────────────────────────────────────────────
# Directory where per-run audit JSONL files are written.
# The directory is created automatically if it does not exist.
FRAUDSHIELD_AUDIT_DIR=var/audit

# ── OpenAI / LLM (Phase 2 — optional) ────────────────────────────────────────
# Required only when the plain-language explanation engine is enabled.
# Leave blank to use rule-based explanations only.
# OPENAI_API_KEY=

# ── Model selection (Phase 3 — optional) ─────────────────────────────────────
# Choose which trained artifact to use for IEEE-CIS scoring.
# Options: extratrees (default), xgboost, lightgbm
# FRAUDSHIELD_MODEL=extratrees

# ── Model artifact integrity ──────────────────────────────────────────────────
# SHA-256 pin for the trusted serialized model artifact.
# The application has a built-in default for the currently reviewed artifact.
# If you intentionally rebuild/replace the artifact, verify it independently
# and set this to its trusted SHA-256 before starting the application.
# Never calculate and accept a new hash blindly from an untrusted artifact.
# FRAUDSHIELD_MODEL_SHA256=replace-with-verified-64-character-sha256
