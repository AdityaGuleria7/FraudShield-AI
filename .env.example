# Copy to .env and set real values. Never commit .env.
FRAUDSHIELD_AUTH_USERNAME=admin
FRAUDSHIELD_AUTH_PASSWORD=change-me-to-a-long-random-password

# Optional: where per-run audit ledgers are written (default: var/audit)
# FRAUDSHIELD_AUDIT_DIR=var/audit

# Optional: pin the IEEE model artifact to a known SHA-256 (see app/ml/artifact_integrity.py)
# FRAUDSHIELD_MODEL_SHA256=
